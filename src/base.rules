all:: MODULE.BASE.build

MODULE.BASE.build: CXX.inherit=MODULE.BASE
MODULE.BASE.build: $(MODULE.BASE.prj)
MODULE.BASE.build: $(MODULE.BASE.pchs)
MODULE.BASE.build: $(MODULE.BASE.a)

$(MODULE.BASE.prj): $(PROJECT/)project/info.py $(PROJECT/)project/info.db
	$(call print.HEADER,GENERATING,$@)
	@$< -h $(PROJECT/)project/info.db > $@.tmp && mv $@.tmp $@

$(MODULE.BASE.pchs): $(MODULE.BASE.prj)
$(MODULE.BASE.pchs): $(BUILD/)base/public.h.$(CXX.pch.ext)/%: $(PROJECT/)src/base/public.h
	$(call CXX.fnPrecompile,$<,$@,$*)

$(MODULE.BASE.objs): $(MODULE.BASE.pchs)
$(MODULE.BASE.objs): $(BUILD/)%.o: $(PROJECT/)src/%.cpp
	$(call CXX.fnCompilePch,$<,$@,base/public.h,$(MODULE.BASE.pchs))

$(MODULE.BASE.a): $(MODULE.BASE.objs)
	$(call CXX.fnCompileStatic,$@,$^)
	$(call CXX.fnRanlib,$@)

###############################################################################

# The .inc files are committed sources; only an explicit `make scramble` regenerates them.
SCRAMBLE.h   = $(PROJECT/)src/bgame/bg_entity_event.h.inc
SCRAMBLE.cpp = $(PROJECT/)src/bgame/bg_entity_event.cpp.inc

.PHONY: scramble
scramble:
	$(call print.HEADER,GENERATING,$(SCRAMBLE.h))
	$(PROJECT/)src/enum-scramble.py -h $(SCRAMBLE.h) > $(SCRAMBLE.h).$$$$ && mv $(SCRAMBLE.h).$$$$ $(SCRAMBLE.h)
	$(call print.HEADER,GENERATING,$(SCRAMBLE.cpp))
	$(PROJECT/)src/enum-scramble.py -cpp $(SCRAMBLE.h) > $(SCRAMBLE.cpp).$$$$ && mv $(SCRAMBLE.cpp).$$$$ $(SCRAMBLE.cpp)
